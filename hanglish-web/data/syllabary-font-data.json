  "vowel": "v_{id}: vowel or diphthong, middle row",
  "mark": "mark_pl / mark_past / mark_poss: grammar marks, their own unit after a block",
  "spacer": "sp{N}: empty, advances N units (0..1500 step 10)"
 },
